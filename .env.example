# ==============================================================================
# Configurações do Servidor Antigravity Mobile
# ==============================================================================

# Porta HTTP local do servidor
PORT=4040

# Diretório padrão para execução e criação de projetos
# (Se deixar em branco, usará a pasta pessoal do usuário)
DEFAULT_WORKSPACE=""

# E-mails permitidos (separados por vírgula)
# (Se deixar em branco, aceitará qualquer e-mail que fizer login no agy da máquina)
ALLOWED_EMAILS=""

# ------------------------------------------------------------------------------
# Conexão Remota Personalizada (Opcional)
# ------------------------------------------------------------------------------
# Se você tiver seu próprio domínio e túnel no Cloudflare Zero Trust,
# preencha seu Token abaixo.
# Se deixar em branco, o servidor gerará automaticamente um Quick Tunnel
# gratuito temporário (*.trycloudflare.com) com QR Code sem precisar de conta!
CLOUDFLARE_TUNNEL_TOKEN=""
PUBLIC_URL=""

# ------------------------------------------------------------------------------
# Google OAuth (Gerenciador de Contas)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Telemetria & Rastreamento de Erros / Crashes (Discord Webhook)
# ------------------------------------------------------------------------------
# Cole aqui a URL do Webhook do seu canal no Discord.
# O servidor enviará relatórios com SO, arquitetura, versão do app e stack trace
# anonimizado (caminhos de pastas e tokens são redigidos) para você reproduzir e corrigir.
ERROR_WEBHOOK_URL=""

# Autorização de telemetria / conformidade LGPD:
# Defina como "true" (padrão) para enviar relatórios anônimos de erro ao Discord.
# Defina como "false" caso o usuário ou cliente corporativo opte por não enviar diagnósticos.
TELEMETRY_ENABLED=true


